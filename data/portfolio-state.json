    "about_content": [
      {
        "id": 1,
        "intro": "Hey — I'm <span class=\"ab-hl\">Aditya</span>. A Computer Science student and <span class=\"ab-hl\">Full-Stack Developer & AI Enthusiast</span> who enjoys building practical digital experiences.",
        "bio": "[\"My journey started with basic Python scripts and C++ fundamentals, which naturally evolved into building full-stack web applications, real-time IoT monitoring systems, and AI-integrated products end-to-end.\",\"I focus on writing clean, scalable code and crafting thoughtful user experiences. Whether it's developing responsive web interfaces, engineering RESTful APIs, or experimenting with machine learning models, I love bringing ideas to life.\",\"Outside of core software development, I explore automotive technology, experiment with embedded hardware like ESP32, and contribute to open-source projects.\"]",
        "info_rows": "[{\"label\":\"Location\",\"value\":\"India 📍\"},{\"label\":\"Degree\",\"value\":\"B.Tech CS — 3rd Year\"},{\"label\":\"Status\",\"value\":\"Seeking Internship 💼\"},{\"label\":\"Focus\",\"value\":\"Full-Stack + AI/ML + IoT\"},{\"label\":\"Languages\",\"value\":\"Python, JavaScript, C++, SQL, HTML/CSS\"}]",
